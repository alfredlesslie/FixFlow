# ==============================================================================
# FixFlow — Environment Configuration (.env.example)
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixflow_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-institution-grade-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Backend Configuration
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_APP_NAME="FixFlow"
