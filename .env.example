# ==============================================================================
# FixFlow — Environment Configuration Template (.env.example)
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env with real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Confirmed host PostgreSQL database runs on port 5432 (e.g. PostgreSQL 17 Windows Service)
# For local host execution (outside Docker):
DATABASE_URL="postgresql://postgres:your-secure-local-password@localhost:5432/fixflow_db?schema=public"

# For Docker container execution reaching host database via host.docker.internal:
DOCKER_DATABASE_URL="postgresql://postgres:your-secure-local-password@host.docker.internal:5432/fixflow_db?schema=public"

# ------------------------------------------------------------------------------
# Authentication & Security (NestJS Backend - Server Only)
# ------------------------------------------------------------------------------
# WARNING: Replace with a cryptographically secure random string in production
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Backend Server Configuration (NestJS)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Reverse Proxy Trust Configuration
# Direct/local: "false" or omit
# Single edge reverse proxy (e.g. AWS ALB / Cloudflare / Nginx): "1"
# Specific VPC CIDR subnet: "loopback, 10.0.0.0/8"
TRUST_PROXY="false"

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Mailpit for dev, SMTP/SendGrid for prod)
# ------------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FixFlow Support <no-reply@fixflow.edu>"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Attachments & Media Storage
# ------------------------------------------------------------------------------
# Driver: "local" (default) or "s3"
ATTACHMENTS_STORAGE_DRIVER="local"
ATTACHMENTS_UPLOAD_DIR="uploads/attachments"

# S3 Configuration (Required only when ATTACHMENTS_STORAGE_DRIVER="s3")
# Compatible with AWS S3, Cloudflare R2, MinIO, Wasabi
# AWS_S3_BUCKET="fixflow-attachments"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_ENDPOINT="" # Leave empty for AWS; set for MinIO or Cloudflare R2

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js - Browser Accessible)
# ------------------------------------------------------------------------------
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Never place secrets (passwords, JWT keys, private tokens) here.
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_APP_NAME="FixFlow"
